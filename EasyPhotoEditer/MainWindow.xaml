<Window x:Class="EasyPhotoEditer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyPhotoEditer"
        mc:Ignorable="d"
        Title="EasyPhotoEditer" Height="600" Width="900"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- メニューバー -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.OpenCommand}" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズームイン(_I)" InputGestureText="Ctrl++" Command="{x:Static local:MainWindow.ZoomInCommand}" />
                <MenuItem Header="ズームアウト(_O)" InputGestureText="Ctrl+-" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
                <MenuItem Header="100% に戻す(_R)" InputGestureText="Ctrl+0" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
                <Separator />
                <MenuItem Header="全体を表示（ウィンドウに合わせる）(_F)" Command="{x:Static local:MainWindow.FitToWindowCommand}" />
                <MenuItem Header="ウィンドウの横幅に合わせる(_W)" Command="{x:Static local:MainWindow.FitToWidthCommand}" />
            </MenuItem>
        </Menu>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusInfoText" Text="準備完了" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CanvasSizeText" Text="サイズ: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomPercentText" Text="ズーム: 100%" />
            </StatusBarItem>
        </StatusBar>

        <!-- メイン作業領域 -->
        <Grid Background="#2D2D30">
            <!-- 未読み込み時の案内ガイド -->
            <StackPanel x:Name="EmptyGuidePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="📷 画像をドラッグ＆ドロップ"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="または [ファイル] → [開く] (Ctrl+O) で画像を選択してください"
                           FontSize="14"
                           Foreground="#888888"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- キャンバス表示用スクロールビューアー -->
            <ScrollViewer x:Name="MainScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20"
                          PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- キャンバスのコンテナ (ドロップシャドウ・枠線・拡大縮小トランスフォーム付き) -->
                    <Border x:Name="CanvasContainer"
                            BorderBrush="#111111"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                        </Border.LayoutTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.6" />
                        </Border.Effect>
                        <!-- キャンバス: 画像ピクセルサイズに一致 -->
                        <Canvas x:Name="ImageCanvas"
                                Background="White"
                                ClipToBounds="True">
                            <Image x:Name="CanvasImage"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Canvas>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
