<Window x:Class="EasyPhotoEditer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyPhotoEditer"
        mc:Ignorable="d"
        Title="EasyPhotoEditer" Height="680" Width="1120" MinHeight="450" MinWidth="1070"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- ツールバー用通常ボタンスタイル -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D7" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ツールバー用トグル(Radio)ボタンスタイル -->
        <Style x:Key="ToolbarRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#094771" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ ComboBoxItem スタイル -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ ComboBox ToggleButton テンプレート -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#AAAAAA"
                          Data="M 0,0 L 3.5,4 L 7,0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#3E3E42" />
                    <Setter TargetName="border" Property="BorderBrush" Value="#0078D7" />
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#0078D7" />
                    <Setter TargetName="arrow" Property="Fill" Value="#0078D7" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ツールバー用ダークテーマ ComboBox スタイル -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="4,0,20,0"
                                     Focusable="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#FFFFFF"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#252526"
                                        BorderBrush="#454545"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ダークテーマ メニュー内の Separator スタイル -->
        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#3A3A3E" HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ ContextMenuItem スタイル -->
        <Style x:Key="DarkContextMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{Binding RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="3"
                                Margin="2,1"
                                Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" SharedSizeGroup="CheckCol" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="GestureCol" />
                                    <ColumnDefinition Width="16" SharedSizeGroup="ArrowCol" />
                                </Grid.ColumnDefinitions>

                                <!-- チェックマーク表示部 -->
                                <Path x:Name="CheckMark"
                                      Grid.Column="0"
                                      Data="M 1,5 L 5,9 L 12,2"
                                      Stroke="#0078D7"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />

                                <!-- テキスト本体 -->
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />

                                <!-- ショートカットキー文字列 (Ctrl+D等) -->
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#888888"
                                           Margin="20,0,4,0"
                                           VerticalAlignment="Center" />

                                <!-- サブメニュー展開矢印 (▶) -->
                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Data="M 0,0 L 4,4 L 0,8 Z"
                                      Fill="#AAAAAA"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />

                                <!-- サブメニューポップアップ -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Right"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#252526"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="2"
                                            Margin="2,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="Black" />
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555555" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ メニューバー用トップレベルテンプレート -->
        <ControlTemplate x:Key="TopLevelMenuItemTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="bd"
                        Background="Transparent"
                        CornerRadius="3"
                        Margin="2,2"
                        Padding="10,4">
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="#252526"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2"
                            Margin="0,1,0,0"
                            Grid.IsSharedSizeScope="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ダークテーマ メニューバー用 MenuItem スタイル -->
        <Style x:Key="DarkMainMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DarkContextMenuItem}">
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ダークテーマ ContextMenu 専用スタイル -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkContextMenuItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#252526"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- キャンバス空白部用 ContextMenu -->
        <ContextMenu x:Key="CanvasContextMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Header="テキストボックス(_T)" Click="CtxCanvasInsert_Click" Tag="TextBox" />
            <MenuItem Header="丸（円）(_C)" Click="CtxCanvasInsert_Click" Tag="Circle" />
            <MenuItem Header="四角形(_R)" Click="CtxCanvasInsert_Click" Tag="Rectangle" />
            <MenuItem Header="角丸四角形(_U)" Click="CtxCanvasInsert_Click" Tag="RoundedRectangle" />
            <MenuItem Header="チェックマーク(_M)" Click="CtxCanvasInsert_Click" Tag="Checkmark" />
            <Separator Style="{StaticResource DarkMenuSeparator}" />
            <MenuItem Header="画像の挿入(_I)..." Click="CtxCanvasInsertImage_Click" />
        </ContextMenu>

        <!-- オブジェクト用 ContextMenu -->
        <ContextMenu x:Key="ObjectContextMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem x:Name="CtxCropMenu" Header="図形に合わせてトリミング(_C)" ItemContainerStyle="{StaticResource DarkContextMenuItem}">
                <MenuItem x:Name="CtxCropRoundedRect" Header="角丸四角(_R)" Click="CtxCrop_Click" Tag="RoundedRectangle" />
                <MenuItem x:Name="CtxCropCircle" Header="丸(_C)" Click="CtxCrop_Click" Tag="Circle" />
                <MenuItem x:Name="CtxCropNone" Header="なし(_N)" Click="CtxCrop_Click" Tag="None" />
            </MenuItem>
            <Separator x:Name="CtxCropSeparator" Style="{StaticResource DarkMenuSeparator}" />
            <MenuItem Header="複製(_D)" InputGestureText="Ctrl+D" Click="CtxDuplicate_Click" />
            <Separator Style="{StaticResource DarkMenuSeparator}" />
            <MenuItem Header="前面に移動(_F)" Click="CtxBringForward_Click" />
            <MenuItem Header="背面に移動(_B)" Click="CtxSendBackward_Click" />
            <Separator Style="{StaticResource DarkMenuSeparator}" />
            <MenuItem Header="削除(_X)" InputGestureText="Delete" Click="MenuDelete_Click" />
        </ContextMenu>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{x:Static local:MainWindow.DuplicateCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <!-- メニューバー -->
        <Menu DockPanel.Dock="Top"
              Background="#1E1E1E"
              Foreground="#E0E0E0"
              BorderBrush="#3F3F46"
              BorderThickness="0,0,0,1"
              Padding="4,1">
            <Menu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMainMenuItem}" />
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource DarkMenuSeparator}" />
            </Menu.Resources>
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.OpenCommand}" />
                <MenuItem Header="編集した画像を保存(_S)..." InputGestureText="Ctrl+S" Command="{x:Static local:MainWindow.SaveCommand}" />
                <Separator />
                <MenuItem Header="オプション(_P)..." Click="Options_Click" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" />
                <MenuItem Header="やり直す(_R)" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Header="画像の挿入(_I)..." Command="{x:Static local:MainWindow.InsertImageCommand}" />
                <Separator />
                <MenuItem x:Name="MenuToolSelect" Header="選択ツール(_S)" IsCheckable="True" IsChecked="True" Click="ToolItem_Click" Tag="Select" />
                <Separator />
                <MenuItem x:Name="MenuToolTextBox" Header="テキストボックス(_T)" IsCheckable="True" Click="ToolItem_Click" Tag="TextBox" />
                <MenuItem x:Name="MenuToolCircle" Header="丸（円）(_C)" IsCheckable="True" Click="ToolItem_Click" Tag="Circle" />
                <MenuItem x:Name="MenuToolRectangle" Header="四角形(_R)" IsCheckable="True" Click="ToolItem_Click" Tag="Rectangle" />
                <MenuItem x:Name="MenuToolRoundedRectangle" Header="角丸四角形(_U)" IsCheckable="True" Click="ToolItem_Click" Tag="RoundedRectangle" />
                <MenuItem x:Name="MenuToolCheckmark" Header="チェックマーク(_M)" IsCheckable="True" Click="ToolItem_Click" Tag="Checkmark" />
                <Separator />
                <MenuItem Header="選択した図形を削除(_D)" InputGestureText="Delete" Click="MenuDelete_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="ズームイン(_I)" InputGestureText="Ctrl++" Command="{x:Static local:MainWindow.ZoomInCommand}" />
                <MenuItem Header="ズームアウト(_O)" InputGestureText="Ctrl+-" Command="{x:Static local:MainWindow.ZoomOutCommand}" />
                <MenuItem Header="100% に戻す(_R)" InputGestureText="Ctrl+0" Command="{x:Static local:MainWindow.ResetZoomCommand}" />
                <Separator />
                <MenuItem Header="全体を表示（ウィンドウに合わせる）(_F)" Command="{x:Static local:MainWindow.FitToWindowCommand}" />
                <MenuItem Header="ウィンドウの横幅に合わせる(_W)" Command="{x:Static local:MainWindow.FitToWidthCommand}" />
            </MenuItem>
        </Menu>

        <!-- モダンツールバー -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <!-- 開く -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:MainWindow.OpenCommand}"
                        ToolTip="画像を開く (Ctrl+O)">
                    <Viewbox Width="18" Height="18">
                        <Path Fill="#E0E0E0"
                              Data="M 2,4 L 8,4 L 10,6 L 20,6 C 21.1,6 22,6.9 22,8 L 22,18 C 22,19.1 21.1,20 20,20 L 2,20 C 0.9,20 0,19.1 0,18 L 0,6 C 0,4.9 0.9,4 2,4 Z M 2,8 L 2,18 L 20,18 L 20,8 Z" />
                    </Viewbox>
                </Button>

                <!-- 編集した画像を保存 -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:MainWindow.SaveCommand}"
                        ToolTip="編集した画像を保存 (Ctrl+S)">
                    <Viewbox Width="17" Height="17">
                        <Path Fill="#E0E0E0"
                              Data="M 3,3 L 17,3 L 21,7 L 21,21 L 3,21 Z M 6,5 L 6,10 L 14,10 L 14,5 Z M 6,14 L 6,19 L 18,19 L 18,14 Z" />
                    </Viewbox>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="6,0" VerticalAlignment="Center" />

                <!-- 元に戻す -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="ApplicationCommands.Undo"
                        ToolTip="元に戻す (Ctrl+Z)">
                    <Viewbox Width="17" Height="17">
                        <Path Stroke="#E0E0E0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 8,4 L 3,9 L 8,14 M 4,9 L 14,9 C 18,9 20,11 20,15 C 20,18 18,19 16,19" />
                    </Viewbox>
                </Button>

                <!-- やり直す -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="ApplicationCommands.Redo"
                        ToolTip="やり直す (Ctrl+Y)">
                    <Viewbox Width="17" Height="17">
                        <Path Stroke="#E0E0E0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 16,4 L 21,9 L 16,14 M 20,9 L 10,9 C 6,9 4,11 4,15 C 4,18 6,19 8,19" />
                    </Viewbox>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="6,0" VerticalAlignment="Center" />

                <!-- 選択ツール -->
                <RadioButton x:Name="TbToolSelect"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="Select"
                             Click="ToolItem_Click"
                             ToolTip="選択ツール (オブジェクトの移動・リサイズ)">
                    <Viewbox Width="17" Height="17">
                        <Path Fill="#E0E0E0"
                              Data="M 3,2 L 9,18 L 12,12 L 18,9 Z" />
                    </Viewbox>
                </RadioButton>

                <!-- テキストボックス -->
                <RadioButton x:Name="TbToolTextBox"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="TextBox"
                             Click="ToolItem_Click"
                             ToolTip="テキストボックス (ドラッグして挿入)">
                    <Viewbox Width="18" Height="18">
                        <Path Stroke="#E0E0E0" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4,5 L 18,5 M 11,5 L 11,19 M 8,19 L 14,19" />
                    </Viewbox>
                </RadioButton>

                <!-- 丸（円） -->
                <RadioButton x:Name="TbToolCircle"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="Circle"
                             Click="ToolItem_Click"
                             ToolTip="丸・円 (クリックで真円 / ドラッグで楕円)">
                    <Ellipse Width="17" Height="17" Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent" />
                </RadioButton>

                <!-- 四角形 -->
                <RadioButton x:Name="TbToolRectangle"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="Rectangle"
                             Click="ToolItem_Click"
                             ToolTip="四角形 (ドラッグして挿入)">
                    <Rectangle Width="17" Height="15" Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent" />
                </RadioButton>

                <!-- 角丸四角形 -->
                <RadioButton x:Name="TbToolRoundedRectangle"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="RoundedRectangle"
                             Click="ToolItem_Click"
                             ToolTip="角丸四角形 (ドラッグして挿入)">
                    <Rectangle Width="17" Height="15" RadiusX="4" RadiusY="4" Stroke="#E0E0E0" StrokeThickness="2" Fill="Transparent" />
                </RadioButton>

                <!-- チェックマーク -->
                <RadioButton x:Name="TbToolCheckmark"
                             Style="{StaticResource ToolbarRadioStyle}"
                             GroupName="ToolGroup"
                             Tag="Checkmark"
                             Click="ToolItem_Click"
                             ToolTip="チェックマーク (クリックして挿入)">
                    <Viewbox Width="17" Height="17">
                        <Path Stroke="#E0E0E0" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 3,11 L 8,16 L 19,4" />
                    </Viewbox>
                </RadioButton>

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="6,0" VerticalAlignment="Center" />

                <!-- 画像の挿入 -->
                <Button Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:MainWindow.InsertImageCommand}"
                        ToolTip="画像の挿入...">
                    <Viewbox Width="17" Height="17">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" RadiusX="2" RadiusY="2"
                                       Stroke="#E0E0E0" StrokeThickness="1.8" Fill="Transparent" />
                            <Ellipse Canvas.Left="6" Canvas.Top="6" Width="3.5" Height="3.5" Fill="#E0E0E0" />
                            <Path Fill="#E0E0E0"
                                  Data="M 3.5,19 L 9,12 L 13.5,17 L 16.5,13.5 L 20.5,19 Z" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="8,0" VerticalAlignment="Center" />

                <!-- テキストボックスのフォント -->
                <TextBlock Text="フォント:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="2,0,4,0" FontSize="11" />
                <ComboBox x:Name="CbFontFamily"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="140" Height="26"
                          Margin="2,0"
                          VerticalAlignment="Center"
                          SelectionChanged="CbFontFamily_SelectionChanged"
                          ToolTip="テキストボックスのフォント" />

                <!-- 文字サイズ -->
                <TextBlock Text="サイズ:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="6,0,4,0" FontSize="11" />
                <ComboBox x:Name="CbFontSize"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="58" Height="26"
                          Margin="2,0"
                          IsEditable="True"
                          VerticalAlignment="Center"
                          SelectionChanged="CbFontSize_SelectionChanged"
                          LostFocus="CbFontSize_LostFocus"
                          KeyDown="CbFontSize_KeyDown"
                          ToolTip="文字サイズ (pt)" />

                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="8,0" VerticalAlignment="Center" />

                <!-- 線の色 / 文字色 -->
                <TextBlock Text="色:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="2,0,4,0" FontSize="11" />
                <ComboBox x:Name="CbStrokeColor"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="95" Height="26"
                          Margin="2,0"
                          VerticalAlignment="Center"
                          SelectionChanged="CbStrokeColor_SelectionChanged"
                          ToolTip="図形の枠線色 / 文字色">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14" Background="{Binding Brush}" BorderBrush="#444" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 線の太さ -->
                <TextBlock Text="太さ:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="6,0,4,0" FontSize="11" />
                <ComboBox x:Name="CbStrokeThickness"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="88" Height="26"
                          Margin="2,0"
                          VerticalAlignment="Center"
                          SelectionChanged="CbStrokeThickness_SelectionChanged"
                          ToolTip="図形の枠線の太さ">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="{Binding PreviewWidth}" Height="{Binding Value}" Fill="#DDD" VerticalAlignment="Center" Margin="{Binding PreviewMargin}" />
                                <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#252526"
                   Foreground="#CCCCCC"
                   BorderBrush="#3F3F46"
                   BorderThickness="0,1,0,0"
                   Padding="6,2">
            <StatusBar.Resources>
                <Style TargetType="Separator">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Rectangle Width="1" Height="14" Fill="#3F3F46" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StatusBar.Resources>
            <StatusBarItem>
                <TextBlock x:Name="StatusInfoText" Text="準備完了" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CanvasSizeText" Text="サイズ: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CurrentToolText" Text="ツール: 選択" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomPercentText" Text="ズーム: 100%" />
            </StatusBarItem>
        </StatusBar>

        <!-- メイン作業領域 -->
        <Grid Background="#2D2D30">
            <!-- 未読み込み時の案内ガイド -->
            <StackPanel x:Name="EmptyGuidePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="📷 画像をドラッグ＆ドロップ"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="または [ファイル] → [開く] (Ctrl+O) で画像を選択してください"
                           FontSize="14"
                           Foreground="#888888"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- キャンバス表示用スクロールビューアー -->
            <ScrollViewer x:Name="MainScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20"
                          PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- キャンバスのコンテナ (ドロップシャドウ・枠線・拡大縮小トランスフォーム付き) -->
                    <Border x:Name="CanvasContainer"
                            BorderBrush="#111111"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                        </Border.LayoutTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.6" />
                        </Border.Effect>
                        <!-- キャンバス: 画像ピクセルサイズに一致 -->
                        <Canvas x:Name="ImageCanvas"
                                Background="White"
                                ClipToBounds="True"
                                MouseLeftButtonDown="ImageCanvas_MouseLeftButtonDown"
                                MouseMove="ImageCanvas_MouseMove"
                                MouseLeftButtonUp="ImageCanvas_MouseLeftButtonUp"
                                MouseRightButtonUp="ImageCanvas_MouseRightButtonUp">
                            <Image x:Name="CanvasImage"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <!-- ドラッグ作成時のプレビュー枠 -->
                            <Rectangle x:Name="RubberBand"
                                       Stroke="#0078D7"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="3,3"
                                       Fill="#220078D7"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False" />
                        </Canvas>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
