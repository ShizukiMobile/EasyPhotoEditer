<UserControl x:Class="EasyPhotoEditer.EditableItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             PreviewMouseLeftButtonDown="UserControl_PreviewMouseLeftButtonDown">
    <UserControl.Resources>
        <!-- リサイズ用ハンドルのスタイル -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="White" Stroke="#0078D7" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- 図形などの実コンテンツコンテナ -->
        <ContentControl x:Name="ContentHost" Margin="4" Focusable="False" />

        <!-- 移動操作用ボーダー (枠周辺または全体ドラッグ: 初期値で透明背景を設定しクリックを確実に捕捉) -->
        <Border x:Name="MoveBorder"
                Background="Transparent"
                Margin="4"
                Cursor="SizeAll"
                MouseLeftButtonDown="MoveBorder_MouseLeftButtonDown"
                MouseMove="MoveBorder_MouseMove"
                MouseLeftButtonUp="MoveBorder_MouseLeftButtonUp" />

        <!-- 選択枠とリサイズハンドル -->
        <Grid x:Name="SelectionOverlay" Visibility="Collapsed" Margin="0">
            <!-- 選択境界破線 -->
            <Rectangle Stroke="#0078D7"
                       StrokeThickness="1"
                       StrokeDashArray="3,3"
                       Margin="4"
                       IsHitTestVisible="False" />

            <!-- リサイズハンドル (8箇所) -->
            <!-- 四隅 -->
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Margin="0"
                   DragDelta="Thumb_TopLeft_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Margin="0"
                   DragDelta="Thumb_TopRight_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Margin="0"
                   DragDelta="Thumb_BottomLeft_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Margin="0"
                   DragDelta="Thumb_BottomRight_DragDelta" />

            <!-- 上下左右の中央 -->
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Cursor="SizeNS" Margin="0"
                   DragDelta="Thumb_Top_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Margin="0"
                   DragDelta="Thumb_Bottom_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Cursor="SizeWE" Margin="0"
                   DragDelta="Thumb_Left_DragDelta" />
            <Thumb Style="{StaticResource ResizeThumbStyle}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Cursor="SizeWE" Margin="0"
                   DragDelta="Thumb_Right_DragDelta" />
        </Grid>
    </Grid>
</UserControl>
