<Window x:Class="EasyPhotoEditer.ConfirmExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyPhotoEditer"
        mc:Ignorable="d"
        Title="終了の確認"
        Height="195" Width="490"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#252526"
        Foreground="#E0E0E0"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo, sans-serif">
    <Window.Resources>
        <!-- プライマリ（終了する）ボタンスタイル -->
        <Style x:Key="PrimaryExitButton" TargetType="Button">
            <Setter Property="Width" Value="95" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C8CE3" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セカンダリ（キャンセル）ボタンスタイル -->
        <Style x:Key="SecondaryCancelButton" TargetType="Button">
            <Setter Property="Width" Value="95" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#777777" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- 上部コンテンツ領域 -->
        <Grid Grid.Row="0" Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- モダンな警告アイコン（円形インフォ・注意） -->
            <Viewbox Grid.Column="0" Width="38" Height="38" VerticalAlignment="Top" Margin="0,2,0,0">
                <Canvas Width="24" Height="24">
                    <!-- 背景サークル -->
                    <Ellipse Width="24" Height="24" Fill="#FFB900" />
                    <!-- ビックリマーク感嘆符 -->
                    <Path Fill="#1E1E1E" Data="M 11,5 L 13,5 L 13,13 L 11,13 Z M 11,16 L 13,16 L 13,18 L 11,18 Z" />
                </Canvas>
            </Viewbox>

            <!-- メッセージ表示 -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="EasyPhotoEditerを閉じます。よろしいですか？"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,8" />
                <TextBlock Text="保存していない編集内容がある場合、終了すると変更はすべて失われます。"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           LineHeight="18" />
            </StackPanel>
        </Grid>

        <!-- 下部アクションバー -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="終了する"
                        Style="{StaticResource PrimaryExitButton}"
                        IsDefault="True"
                        Click="BtnExit_Click" />
                <Button Content="キャンセル"
                        Style="{StaticResource SecondaryCancelButton}"
                        IsCancel="True"
                        Margin="10,0,0,0"
                        Click="BtnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
