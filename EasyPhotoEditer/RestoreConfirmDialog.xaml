<Window x:Class="EasyPhotoEditer.RestoreConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="作業内容の復元 - EasyPhotoEditer"
        Icon="pack://application:,,,/EasyPhotoEditer.ico"
        Height="215" Width="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#252526"
        Foreground="#E0E0E0"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo, sans-serif">
    <Window.Resources>
        <Style x:Key="PrimaryRestoreButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C8CE3" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryDiscardButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#777777" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- 上部コンテンツ領域 -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- インフォメーション/復元アイコン (青丸に i) -->
            <Viewbox Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                <Canvas Width="24" Height="24">
                    <Ellipse Width="22" Height="22" Canvas.Left="1" Canvas.Top="1" Fill="#0078D7" />
                    <Path Fill="#FFFFFF" Data="M 11,6.5 L 13,6.5 L 13,8.5 L 11,8.5 Z M 11,10.5 L 13,10.5 L 13,17.5 L 11,17.5 Z" />
                </Canvas>
            </Viewbox>

            <!-- メッセージ表示 -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="前回のセッションが正常に終了されませんでした。"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="TxtDescription"
                           Text="自動保存された作業内容が見つかりました。前回の編集状態を復元しますか？"
                           FontSize="12"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="TxtBackupInfo"
                           FontSize="11.5"
                           Foreground="#9CDCFE"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- 下部アクションバー -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="復元する"
                        Style="{StaticResource PrimaryRestoreButton}"
                        IsDefault="True"
                        Click="BtnRestore_Click" />
                <Button Content="破棄して新規起動"
                        Style="{StaticResource SecondaryDiscardButton}"
                        IsCancel="True"
                        Margin="10,0,0,0"
                        Click="BtnDiscard_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
