<Window x:Class="EasyPhotoEditer.CrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="予期せぬエラー - EasyPhotoEditer"
        Icon="pack://application:,,,/EasyPhotoEditer.ico"
        Height="290" Width="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#252526"
        Foreground="#E0E0E0"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo, sans-serif">
    <Window.Resources>
        <Style x:Key="PrimaryOkButton" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#0078D7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#005A9E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C8CE3" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryDarkButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#777777" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- 上部コンテンツ領域 -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- エラーアイコン (赤丸に×) -->
            <Viewbox Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                <Canvas Width="24" Height="24">
                    <Ellipse Width="22" Height="22" Canvas.Left="1" Canvas.Top="1" Fill="#E81123" />
                    <Path Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 7.5,7.5 L 16.5,16.5 M 16.5,7.5 L 7.5,16.5" />
                </Canvas>
            </Viewbox>

            <!-- メッセージおよびログ情報 -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="予期せぬエラーが発生したため、アプリを終了します。"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <TextBlock Text="ご不便をおかけして申し訳ありません。問題の原因調査と修正のため、よろしければ下記のクラッシュログファイルを開発者のX(@shizuki0918)のDMへお送りください。"
                           FontSize="12"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock Text="クラッシュログの保存先:"
                           FontSize="11"
                           Foreground="#AAAAAA"
                           Margin="0,0,0,3" />
                <TextBox x:Name="TxtLogPath"
                         IsReadOnly="True"
                         Background="#1E1E1E"
                         Foreground="#E0E0E0"
                         BorderBrush="#3F3F46"
                         BorderThickness="1"
                         Padding="6,4"
                         FontSize="11"
                         Margin="0,0,0,10" />

                <TextBlock x:Name="TxtBackupNotice"
                           Text="※ 編集中の作業内容は自動バックアップされました。次回起動時に復元できます。"
                           FontSize="11.5"
                           Foreground="#4EC9B0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- 下部ボタンエリア -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <Button Content="ログフォルダを開く"
                        Style="{StaticResource SecondaryDarkButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="BtnOpenLogFolder_Click" />

                <Button Content="OK（終了）"
                        Style="{StaticResource PrimaryOkButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsDefault="True"
                        Click="BtnOk_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
