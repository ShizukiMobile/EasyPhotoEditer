<Window x:Class="EasyPhotoEditer.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyPhotoEditer"
        mc:Ignorable="d"
        Title="オプション" Height="500" Width="600"
        Icon="pack://application:,,,/EasyPhotoEditer.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#252526"
        Foreground="#E0E0E0"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo, sans-serif">
    <Window.Resources>
        <!-- カテゴリ用 RadioButton スタイル -->
        <Style x:Key="CategoryRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333337" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#094771" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ CheckBox スタイル -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="checkBoxBorder"
                                    Width="16" Height="16"
                                    Background="#333337"
                                    BorderBrush="#555555"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <Path x:Name="checkMark"
                                      Data="M 3,7.5 L 6,10.5 L 12,4"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#0078D7" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#1C8AE6" />
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#1C8AE6" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークテーマ RadioButton スタイル -->
        <Style x:Key="StandardRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="radioOuter"
                                         Fill="#333337"
                                         Stroke="#555555"
                                         StrokeThickness="1" />
                                <Ellipse x:Name="radioInner"
                                         Width="6" Height="6"
                                         Fill="#FFFFFF"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="radioOuter" Property="Fill" Value="#0078D7" />
                                <Setter TargetName="radioOuter" Property="Stroke" Value="#0078D7" />
                                <Setter TargetName="radioInner" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="radioOuter" Property="Stroke" Value="#0078D7" />
                                <Setter TargetName="radioOuter" Property="Fill" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="radioOuter" Property="Fill" Value="#1C8AE6" />
                                <Setter TargetName="radioOuter" Property="Stroke" Value="#1C8AE6" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ダークボタン スタイル -->
        <Style x:Key="DarkDialogButton" TargetType="Button">
            <Setter Property="Width" Value="85" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0078D7" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#005A9E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コンボボックス用アイテムスタイル -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#094771" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 設定画面用 ComboBox スタイル -->
        <Style x:Key="DarkSettingComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tbBorder"
                                                Background="#333337"
                                                BorderBrush="#454545"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="#AAAAAA" Data="M 0,0 L 3.5,4 L 7,0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tbBorder" Property="Background" Value="#3E3E42" />
                                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#0078D7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="6,0,22,0"
                                     Focusable="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#E0E0E0"
                                     CaretBrush="#FFFFFF"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220"
                                        Background="#252526"
                                        BorderBrush="#454545"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左ペイン: カテゴリ一覧 -->
            <Border Grid.Column="0"
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,1,0"
                    Padding="4,8">
                <StackPanel>
                    <RadioButton x:Name="RbCategoryGeneral"
                                 Style="{StaticResource CategoryRadioStyle}"
                                 GroupName="CategoryGroup"
                                 IsChecked="True"
                                 Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="一般" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbCategoryEdit"
                                 Style="{StaticResource CategoryRadioStyle}"
                                 GroupName="CategoryGroup"
                                 Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="編集" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- 右ペイン: 各設定画面 -->
            <Border Grid.Column="1" Padding="20,16">
                <Grid>
                    <!-- 一般設定パネル -->
                    <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                        <TextBlock Text="一般設定" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12" />
                        <Border Height="1" Background="#3F3F46" Margin="0,0,0,16" />

                        <CheckBox x:Name="ChkConfirmOnExit" Content="終了前に確認する" />
                        <TextBlock Text="アプリケーション終了時に、未保存の変更に対する確認ダイアログを表示します。"
                                   FontSize="11" Foreground="#888888" Margin="22,2,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="画像をドラッグ＆ドロップしたときの動作" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,20,0,8" />
                        <Border Height="1" Background="#3F3F46" Margin="0,0,0,10" />

                        <RadioButton x:Name="RbDragDropOpenNew"
                                     Style="{StaticResource StandardRadioStyle}"
                                     GroupName="DragDropActionGroup"
                                     Content="画像を新しく開く"
                                     IsChecked="True" />
                        <RadioButton x:Name="RbDragDropComposite"
                                     Style="{StaticResource StandardRadioStyle}"
                                     GroupName="DragDropActionGroup"
                                     Content="画像を編集中の画像に合成する" />
                    </StackPanel>

                    <!-- 編集設定パネル -->
                    <ScrollViewer x:Name="PanelEdit" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="編集の既定値" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                            <Border Height="1" Background="#3F3F46" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>

                                <!-- フォント -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="フォント:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="CbDefaultFont" Grid.Row="0" Grid.Column="1"
                                          Style="{StaticResource DarkSettingComboBox}" Width="200" HorizontalAlignment="Left" />

                                <!-- 文字サイズ -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="文字サイズ:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="CbDefaultFontSize" Grid.Row="1" Grid.Column="1"
                                          Style="{StaticResource DarkSettingComboBox}" Width="90" IsEditable="True" HorizontalAlignment="Left" />

                                <!-- 文字色 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="文字色:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="CbDefaultTextColor" Grid.Row="2" Grid.Column="1"
                                          Style="{StaticResource DarkSettingComboBox}" Width="130" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="14" Height="14" Background="{Binding Brush}" BorderBrush="#444" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 図形色 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="図形色:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="CbDefaultShapeColor" Grid.Row="3" Grid.Column="1"
                                          Style="{StaticResource DarkSettingComboBox}" Width="130" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="14" Height="14" Background="{Binding Brush}" BorderBrush="#444" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- 線の太さ -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="線の太さ:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                                <ComboBox x:Name="CbDefaultStrokeThickness" Grid.Row="4" Grid.Column="1"
                                          Style="{StaticResource DarkSettingComboBox}" Width="130" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="{Binding PreviewWidth}" Height="{Binding Value}" Fill="#DDD" VerticalAlignment="Center" Margin="{Binding PreviewMargin}" />
                                                <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="右クリックで図形を挿入するときの動作" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,8" />
                            <Border Height="1" Background="#3F3F46" Margin="0,0,0,10" />

                            <RadioButton x:Name="RbRightClickClickToInsert"
                                         Style="{StaticResource StandardRadioStyle}"
                                         GroupName="RightClickActionGroup"
                                         Content="クリック位置に挿入する"
                                         IsChecked="True" />
                            <RadioButton x:Name="RbRightClickDragToSpecify"
                                         Style="{StaticResource StandardRadioStyle}"
                                         GroupName="RightClickActionGroup"
                                         Content="ドラッグして位置を指定する" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 下部: ダイアログボタン -->
        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="OK"
                        Style="{StaticResource DarkDialogButton}"
                        IsDefault="True"
                        Click="BtnOk_Click" />
                <Button Content="キャンセル"
                        Style="{StaticResource DarkDialogButton}"
                        IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
